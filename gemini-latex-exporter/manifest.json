{
  "manifest_version": 3,
  "name": "Gemini LaTeX Docs Exporter",
  "version": "1.0.0",
  "description": "Export Gemini responses to Google Docs with clean, editable LaTeX text instead of fuzzy images.",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_gemini.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ],
  "key": ""
}