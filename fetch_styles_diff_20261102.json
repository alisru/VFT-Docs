+}
+.hk-body {
+  flex: 1 1 auto;
+  padding: 8px;
+  overflow: auto;
+  display: flex;
+  flex-direction: row;
+  flex-wrap: wrap;
+  align-items: flex-start;
+  align-content: flex-start;
+  gap: 6px;
+  background: var(--bg);
+  background-image: radial-gradient(var(--border) 1.2px, transparent 1.2px);
+  background-size: 20px 20px;
+  box-sizing: border-box;
+  position: relative;
+}
+.hk-empty-hint {
+  width: 100%;
+  padding: 28px 12px;
+  text-align: center;
+  color: var(--muted);
+  font-size: 11.5px;
+  pointer-events: none;
+  user-select: none;
+}
+.hk-item-card {
+  width: 90px;
+  height: 82px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: flex-start;
+  padding: 6px 4px;
+  border-radius: 4px;
+  border: 1px solid transparent;
+  background: var(--card);
+  cursor: pointer;
+  position: relative;
+  box-sizing: border-box;
+  text-align: center;
+  overflow: hidden;
+}
+.hk-item-card:hover {
+  background: var(--hover);
+  border-color: var(--border);
+}
+.hk-item-card .hk-card-ico {
+  width: 32px;
+  height: 32px;
+  object-fit: contain;
+  margin-bottom: 4px;
+}
+.hk-item-card .hk-card-nm {
+  font-size: 10.5px;
+  color: var(--fg);
+  line-height: 1.2;
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+}
+.hk-item-card .hk-card-del {
+  position: absolute;
+  top: 2px;
+  right: 2px;
+  width: 16px;
+  height: 16px;
+  font-size: 10px;
+  border-radius: 50%;
+  background: rgba(0, 0, 0, 0.4);
+  color: #fff;
+  display: none;
+  align-items: center;
+  justify-content: center;
+  line-height: 1;
+}
+.hk-item-card:hover .hk-card-del {
+  display: flex;
+}
+.hk-item-card .hk-card-del:hover {
+  background: #ef4444;
+}
